{
  "background_color": "#ffffff",
  "description": "本地听书：导入 PDF/EPUB/TXT/DOCX/FB2/HTML/MD，语音朗读、AI 伴读",
  "display": "standalone",
  "icons": [
    {
      "sizes": "192x192",
      "src": "icon-192.png",
      "type": "image/png"
    },
    {
      "purpose": "any maskable",
      "sizes": "512x512",
      "src": "icon-512.png",
      "type": "image/png"
    }
  ],
  "lang": "zh-CN",
  "name": "DeepRead · 把书听成故事",
  "orientation": "portrait",
  "scope": "./",
  "short_name": "DeepRead",
  "start_url": "./index.html",
  "theme_color": "#ffffff",
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "text/plain": [
          ".txt"
        ],
        "application/x-mobipocket-ebook": [
          ".mobi"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "book",
          "accept": [
            ".epub",
            ".pdf",
            ".txt",
            ".mobi"
          ]
        }
      ]
    }
  }
}